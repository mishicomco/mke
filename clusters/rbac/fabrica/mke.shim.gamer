#!/usr/bin/env bash
set -euo pipefail
export PATH=/opt/node/bin:$PATH
export DOCKER_HOST="${DOCKER_HOST:-unix:///run/user/1001/docker.sock}"
# creds de CI no-vault (p.ej. CLOUDFLARE_DNS_API), archivo 600 propio de mke-ci
if [ -f "$HOME/.config/mishi/ci.env" ]; then set -a; . "$HOME/.config/mishi/ci.env"; set +a; fi
cd /home/mke-ci/mke/cli
exec node --import tsx src/mke.ts "$@"
